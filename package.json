{
  "name": "visual-math-editor",
  "version": "0.8.1",
  "private": true,
  "description": "Visual Math: beginner-friendly math, chemistry and physics notes, equation graphs and unit conversion for Obsidian, entirely offline",
  "keywords": [
    "obsidian-plugin",
    "visual-math",
    "equation-editor",
    "wysiwyg",
    "latex",
    "markdown",
    "mathlive",
    "math-notes",
    "science-notes",
    "chemistry",
    "physics",
    "function-plotter",
    "complex-plane",
    "unit-conversion",
    "periodic-table",
    "offline",
    "polar-plot",
    "3d-graph",
    "calculus",
    "trigonometry"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "node scripts/build.mjs --preview && node scripts/serve.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "convert": "8.0.2",
    "mathlive": "0.111.1"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "SEE LICENSE IN LICENSING.md"
}
